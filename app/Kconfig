menuconfig LED_SUBSYSTEM
    bool "Enable led subsytem"
    default y

if LED_SUBSYSTEM

choice 
    prompt "LED blink speed"
    default BLINK_SPEED_1000MS


config BLINK_SPEED_200MS
    bool "Fast"

config BLINK_SPEED_1000MS
    bool "Normal"

config BLINK_SPEED_2000MS
    bool "Slow"

endchoice

config BLINK_SLEEP_TIME_MS
    int
    default 200 if BLINK_SPEED_200MS
    default 1000 if BLINK_SPEED_1000MS
    default 2000 if BLINK_SPEED_2000MS
    default 0

menuconfig ADVANCED_LED_SETTING
    bool "Enable advanced setting"
    default n

if ADVANCED_LED_SETTING

config LED_BRIGHTNESS
    int "Led brightness"
    default 100
    range 0 100

config LED_FADE_DURATION_MS
    int "Led fade duration"
    default 500
    range 0 1000

menu "EXPERT SETTING"

visible if ADVANCED_LED_SETTING

config LED_DEBUGGING
    bool "Enable led debugging"
    default n

config CUSTOM_BLINK_PATTERN
    bool "Enable custom blink pattern"
    default n

endmenu

endif


endif



source "Kconfig.zephyr"